NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Database (development copy of car_tracking)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=car_tracking_dev
DB_USER=root
DB_PASS=
DB_SSL=false
DB_SSL_CA=

# Sessions
SESSION_SECRET=change-me-to-64-random-characters
SESSION_MAX_AGE_HOURS=8

# Single admin login. Set the password with: npm run auth:set-password -w server -- "new password"
ADMIN_USER=admin
ADMIN_PASS_HASH=

# Logging and files
LOG_LEVEL=debug
LOG_DIR=./logs
UPLOAD_DIR=./uploads
